{
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "node"],
    "paths": {
      "@acc/core": ["../../packages/core/src/index.ts"],
      "@acc/core/*": ["../../packages/core/src/*"],
      "@acc/ir": ["../../packages/ir/src/index.ts"],
      "@acc/ir/*": ["../../packages/ir/src/*"],
      "@acc/effect-engines": ["../../packages/effect-engines/src/index.ts"],
      "@acc/effect-engines/*": ["../../packages/effect-engines/src/*"]
    }
  },
  "include": ["src/**/*"]
}
