{
  "extends": "@acc/typescript-config/base.json",
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "noImplicitAny": true,
    "target": "ESNext",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "electrobun/main": [".hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/*": [".hutch/devkit/api/*"]
    }
  }
}
