{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/data/*": ["data/*"]
    }
  },
  "include": [
    "src/**/*",
    "data/**/*",
    "astro.config.mjs"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
