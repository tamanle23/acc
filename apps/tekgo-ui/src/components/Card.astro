---
interface Props {
  title: string;
  description: string;
  imgSrc?: string;
  href?: string;
}

const { title, description, imgSrc, href } = Astro.props;
---
<div class="md max-w-[544px] p-4 md:w-1/2">
  <div class="glass-card h-full overflow-hidden rounded-2xl transition-all duration-300 hover:shadow-xl hover:scale-[1.01]">
    {imgSrc && (
      href ? (
        <a href={href} aria-label={`Link to ${title}`}>
          <img
            alt={title}
            src={imgSrc}
            class="object-cover object-center w-full md:h-36 lg:h-48"
            loading="lazy"
          />
        </a>
      ) : (
        <img
          alt={title}
          src={imgSrc}
          class="object-cover object-center w-full md:h-36 lg:h-48"
          loading="lazy"
        />
      )
    )}
    <div class="p-6">
      <h2 class="mb-3 text-2xl font-bold leading-8 tracking-tight">
        {href ? (
          <a href={href} class="text-gray-900 transition-colors hover:text-primary-500 dark:text-gray-100 dark:hover:text-primary-400">
            {title}
          </a>
        ) : (
          <span class="text-gray-900 dark:text-gray-100">{title}</span>
        )}
      </h2>
      <p class="prose mb-3 max-w-none text-gray-500 dark:text-gray-400">{description}</p>
      {href && (
        <a
          href={href}
          class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400 text-base font-medium leading-6 transition-colors"
          aria-label={`Link to ${title}`}
        >
          Learn more &rarr;
        </a>
      )}
    </div>
  </div>
</div>
