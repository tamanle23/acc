---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contentProvider } from '../lib/cms/content-provider';
import { allCoreContent } from '../lib/content';
import { formatDate, slug } from '../lib/utils';
import siteMetadata from '@/data/siteMetadata';

export const prerender = false;

const MAX_DISPLAY = 5;
const allPosts = await contentProvider.getAllBlogs();
const posts = allCoreContent(allPosts);
---
<BaseLayout title={siteMetadata.title} description={siteMetadata.description}>
  <div class="divide-y divide-gray-200 dark:divide-gray-800">
    <!-- Hero Section -->
    <div class="space-y-2 pt-6 pb-8 md:space-y-5">
      <h1 class="text-3xl font-extrabold leading-9 tracking-tight text-gray-900 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14 dark:text-gray-100">
        Latest Articles
      </h1>
      <p class="text-lg leading-7 text-gray-500 dark:text-gray-400">
        {siteMetadata.description}
      </p>
    </div>

    <!-- Posts Feed -->
    <ul class="divide-y divide-gray-200 dark:divide-gray-800">
      {!posts.length && <li class="py-12 text-center text-gray-500">No posts found.</li>}
      {posts.slice(0, MAX_DISPLAY).map((post) => {
        const { slug: postSlug, date, title, summary, tags } = post;
        return (
          <li class="py-12">
            <article>
              <div class="space-y-2 xl:grid xl:grid-cols-4 xl:items-baseline xl:space-y-0">
                <dl>
                  <dt class="sr-only">Published on</dt>
                  <dd class="text-base font-medium leading-6 text-gray-500 dark:text-gray-400">
                    <time datetime={date}>{formatDate(date, siteMetadata.locale)}</time>
                  </dd>
                </dl>
                <div class="space-y-5 xl:col-span-3">
                  <div class="space-y-4">
                    <div>
                      <h2 class="text-2xl font-bold leading-8 tracking-tight">
                        <a
                          href={`/blog/${postSlug}`}
                          class="text-gray-900 transition-colors hover:text-primary-500 dark:text-gray-100 dark:hover:text-primary-400"
                        >
                          {title}
                        </a>
                      </h2>
                      <div class="flex flex-wrap gap-2 mt-2">
                        {tags?.map((t) => (
                          <a
                            href={`/tags/${slug(t)}`}
                            class="mr-3 text-sm font-medium uppercase text-primary-500 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                          >
                            #{t}
                          </a>
                        ))}
                      </div>
                    </div>
                    {summary && (
                      <div class="prose max-w-none text-gray-500 dark:text-gray-400">
                        {summary}
                      </div>
                    )}
                  </div>
                  <div class="text-base font-medium leading-6">
                    <a
                      href={`/blog/${postSlug}`}
                      class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                      aria-label={`Read "${title}"`}
                    >
                      Read more &rarr;
                    </a>
                  </div>
                </div>
              </div>
            </article>
          </li>
        );
      })}
    </ul>
  </div>

  {posts.length > MAX_DISPLAY && (
    <div class="flex justify-end text-base font-medium leading-6 pt-6">
      <a
        href="/blog"
        class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
        aria-label="All posts"
      >
        All Posts &rarr;
      </a>
    </div>
  )}

  <!-- Newsletter Glass Card -->
  {siteMetadata.newsletter?.provider && (
    <div class="glass-card my-12 flex items-center justify-center p-8 rounded-2xl">
      <div class="w-full max-w-md text-center">
        <h3 class="text-xl font-bold tracking-tight text-gray-900 dark:text-gray-100 mb-2">
          Subscribe to the newsletter
        </h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
          Get the latest posts and updates delivered directly to your inbox.
        </p>
        <form action="/api/newsletter" method="POST" class="flex flex-col sm:flex-row gap-2">
          <input
            type="email"
            name="email"
            required
            placeholder="Enter your email"
            class="flex-1 rounded-xl border border-gray-300 dark:border-gray-700 bg-white/70 dark:bg-slate-900/70 px-4 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
          />
          <button
            type="submit"
            class="rounded-xl bg-primary-500 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-600 transition-colors"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>
  )}
</BaseLayout>
