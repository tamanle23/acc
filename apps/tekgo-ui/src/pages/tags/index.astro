---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import { contentProvider } from '../../lib/cms/content-provider';

export const prerender = false;

const tagCounts = await contentProvider.getTagData();
const tagKeys = Object.keys(tagCounts);
const sortedTags = tagKeys.sort((a, b) => tagCounts[b] - tagCounts[a]);
---
<BaseLayout title="Tags">
  <div class="flex flex-col items-start justify-start divide-y divide-gray-200 md:mt-24 md:flex-row md:items-center md:justify-center md:space-x-6 md:divide-y-0 dark:divide-gray-800">
    <div class="space-x-2 pt-6 pb-8 md:space-y-5">
      <h1 class="text-3xl font-extrabold leading-9 tracking-tight text-gray-900 sm:text-4xl sm:leading-10 md:border-r-2 md:px-6 md:text-6xl md:leading-14 dark:border-gray-800 dark:text-gray-100">
        Tags
      </h1>
    </div>
    <div class="flex max-w-lg flex-wrap py-4">
      {!tagKeys.length && <div class="text-gray-500">No tags found.</div>}
      {sortedTags.map((t) => (
        <div class="mt-2 mb-2 mr-5 flex items-center">
          <Tag text={t} />
          <span class="-ml-1 text-sm font-semibold uppercase text-gray-600 dark:text-gray-400">
            ({tagCounts[t]})
          </span>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
