---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogFilterList from '../../../components/BlogFilterList';
import { contentProvider } from '../../../lib/cms/content-provider';
import { allCoreContent } from '../../../lib/content';

export const prerender = false;

const POSTS_PER_PAGE = 5;
const allPosts = await contentProvider.getAllBlogs();
const posts = allCoreContent(allPosts);
const pageNumber = parseInt(Astro.params.page || '1', 10);
const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);

if (isNaN(pageNumber) || pageNumber <= 0 || pageNumber > totalPages) {
  return Astro.redirect('/blog');
}

const initialDisplayPosts = posts.slice(
  POSTS_PER_PAGE * (pageNumber - 1),
  POSTS_PER_PAGE * pageNumber
);
const pagination = {
  currentPage: pageNumber,
  totalPages,
  basePath: 'blog',
};
---
<BaseLayout title={`All Articles - Page ${pageNumber}`}>
  <BlogFilterList
    posts={posts}
    initialDisplayPosts={initialDisplayPosts}
    pagination={pagination}
    title="All Articles"
    client:idle
  />
</BaseLayout>

