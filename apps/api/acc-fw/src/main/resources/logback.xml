<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <include resource="org/springframework/boot/logging/logback/base.xml"/>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [%X{trace_id:-}] [%X{tenant_id:-}] [%X{user_id:-}] [%X{workspace_id:-}] - %msg%n</pattern>
    </encoder>
  </appender>
  <appender name="COUNTER_FILE"
    class="ch.qos.logback.core.rolling.RollingFileAppender">
    <File>./logs/app.log</File>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>./logs/app-%d{yyyy-MM-dd-HH}.log</fileNamePattern>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger [%X{trace_id:-}] [%X{tenant_id:-}] [%X{user_id:-}] [%X{workspace_id:-}] - %msg%n</pattern>
    </encoder>
  </appender>
  <appender name="ASYNC_COUNTER_FILE" class="ch.qos.logback.classic.AsyncAppender">
    <discardingThreshold>0</discardingThreshold>
    <queueSize>10000</queueSize>
    <appender-ref ref="COUNTER_FILE" />
  </appender>
