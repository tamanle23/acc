          "dataType": "STRING",
          "uiComponent": "text",
          "isRequired": true,
          "displayOrder": 1
        },
        {
          "systemName": "property_title",
          "name": "Listing Title",
          "dataType": "STRING",
          "uiComponent": "text",
          "isRequired": true,
          "displayOrder": 2
