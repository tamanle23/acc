        {
          "systemName": "is_featured",
          "name": "Featured Showcase",
          "dataType": "BOOLEAN",
          "uiComponent": "switch",
          "isRequired": true,
          "displayOrder": 6,
          "defaultValue": "false"
        }
      ]
    },
    {
      "systemName": "ent_listing_agent",
      "name": "Licensed Realtor Agent",
