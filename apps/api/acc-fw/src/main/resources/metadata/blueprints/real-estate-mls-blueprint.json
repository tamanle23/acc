        {
          "systemName": "client_name",
          "name": "Prospective Buyer Name",
          "dataType": "STRING",
          "uiComponent": "text",
          "isRequired": true,
          "displayOrder": 2
        },
        {
          "systemName": "tour_status",
          "name": "Appointment Status",
          "dataType": "STRING",
          "uiComponent": "select",
          "isRequired": true,
