        {
          "systemName": "license_number",
          "name": "Realtor License Number",
          "dataType": "STRING",
          "uiComponent": "text",
          "isRequired": true,
          "displayOrder": 1
        },
        {
          "systemName": "agent_name",
          "name": "Full Name",
          "dataType": "STRING",
          "uiComponent": "text",
          "isRequired": true,
          "displayOrder": 2
        },
        {
          "systemName": "brokerage_agency",
          "name": "Brokerage Firm",
          "dataType": "STRING",
          "uiComponent": "text",
          "isRequired": true,
          "displayOrder": 3
        },
        {
          "systemName": "contact_email",
          "name": "Agent Email",
          "dataType": "STRING",
          "uiComponent": "text",
          "isRequired": true,
          "displayOrder": 4
        }
      ]
    },
    {
      "systemName": "ent_tour_schedule",
      "name": "Property Tour Appointment",
      "description": "Prospective buyer walkthrough appointments and open houses",
      "attributes": [
        {
          "systemName": "appointment_time",
          "name": "Tour Date & Time",
          "dataType": "DATETIME",
          "uiComponent": "datepicker",
          "isRequired": true,
          "displayOrder": 1
