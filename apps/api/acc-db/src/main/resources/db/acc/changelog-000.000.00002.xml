<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="hybrid-metadata-schema-evolution-02" author="antigravity">
        <!-- 1. Schema version on Entity Types -->
        <addColumn tableName="UNIPOST_ENTITY_TYPES">
            <column name="schema_version" type="BIGINT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <!-- 2. Display order on Attribute Definitions -->
        <addColumn tableName="UNIPOST_ATTRIBUTE_DEFINITIONS">
            <column name="display_order" type="INT" defaultValueNumeric="0"/>
        </addColumn>

        <!-- 3. Schema version on Entities (Records) -->
        <addColumn tableName="UNIPOST_ENTITIES">
            <column name="schema_version" type="BIGINT" defaultValueNumeric="1"/>
        </addColumn>

        <!-- 4. Replace AttributeDefinition unique constraint with partial unique index for soft-delete support -->
        <dropUniqueConstraint tableName="UNIPOST_ATTRIBUTE_DEFINITIONS" constraintName="uk_attr_def_type_sysname"/>
        <sql dbms="postgresql">
            CREATE UNIQUE INDEX uk_attr_def_type_sysname_active
            ON UNIPOST_ATTRIBUTE_DEFINITIONS (entity_type_id, system_name)
            WHERE "deletedDate" IS NULL;
        </sql>

        <!-- 5. Replace EntityType system_name unique constraint with partial unique index for soft-delete support -->
        <sql dbms="postgresql" splitStatements="false">
          <![CDATA[
              DO $$
              DECLARE r RECORD;
              BEGIN
                  FOR r IN (
                      SELECT conname
                      FROM pg_constraint
                      WHERE conrelid = 'UNIPOST_ENTITY_TYPES'::regclass
                        AND contype = 'u'
                        AND pg_get_constraintdef(oid) LIKE '%system_name%'
                  ) LOOP
                      EXECUTE 'ALTER TABLE UNIPOST_ENTITY_TYPES DROP CONSTRAINT ' || quote_ident(r.conname);
                  END LOOP;
              END;
              $$;
          ]]>
        </sql>
        <sql dbms="postgresql">
            CREATE UNIQUE INDEX uk_entity_type_sysname_active
            ON UNIPOST_ENTITY_TYPES (system_name)
            WHERE "deletedDate" IS NULL;
        </sql>
    </changeSet>

</databaseChangeLog>
