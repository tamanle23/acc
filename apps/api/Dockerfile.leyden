FROM eclipse-temurin:17-jdk-alpine AS builder

WORKDIR /workspace

# Copy maven wrapper and pom files
COPY mvnw .
COPY .mvn .mvn
COPY pom.xml .
COPY acc-core/pom.xml acc-core/
COPY acc-resources/pom.xml acc-resources/
COPY acc-fw/pom.xml acc-fw/
COPY acc-db/pom.xml acc-db/
COPY acc-ms-fs/pom.xml acc-ms-fs/
COPY acc-ms-identity/pom.xml acc-ms-identity/
COPY acc-report-engine/pom.xml acc-report-engine/
COPY acc-ms-worker/pom.xml acc-ms-worker/
COPY acc-ms-aio/pom.xml acc-ms-aio/

# Download dependencies
RUN ./mvnw dependency:go-offline -B

# Copy source code
COPY . .

# Build the jar
RUN ./mvnw -pl acc-ms-aio -am clean package -DskipTests
RUN cp acc-ms-aio/target/acc-ms-aio-*.jar /workspace/app.jar

FROM eclipse-temurin:17-jre-alpine

WORKDIR /app
COPY --from=builder /workspace/app.jar app.jar

# Create a CDS archive during the build phase by doing a training run
RUN java -XX:ArchiveClassesAtExit=application.jsa -Dspring.context.exit=onRefresh -jar app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-XX:SharedArchiveFile=application.jsa", "-jar", "app.jar"]
