<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.unipost.user.repository.mybatis.UserSearchRepository">
  <select id="count" resultType="java.lang.Long">
      SELECT count(0)
      FROM ${table_prefix_identity}user
      <include refid="searchCondition"></include>
  </select>
  <select id="findBy" resultType="com.unipost.user.model.User">
      SELECT *
      FROM ${table_prefix_identity}user
      <include refid="searchCondition"></include>
      LIMIT #{pageRequest.size} OFFSET #{pageRequest.offset};
  </select>
  <sql id="searchCondition">
  </sql>
</mapper>
