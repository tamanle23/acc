{
  "name": "@acc/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Acc Java Spring Modulith backend with acc-ms-aio wrapper application",
  "scripts": {
    "build": "node mvnw.cjs clean install -DskipTests",
    "build:prod": "node mvnw.cjs clean package -DskipTests -Pprod -DexcludeSandbox",
    "build:no-sandbox": "node mvnw.cjs clean package -DskipTests -DexcludeSandbox",
    "dev": "node mvnw.cjs compile -pl acc-ms-aio spring-boot:run -Dspring-boot.run.profiles=local -Djava.net.preferIPv4Stack=true",
    "dev:sandbox": "node mvnw.cjs compile -pl acc-ms-aio spring-boot:run -Dspring-boot.run.profiles=local,sandbox -Djava.net.preferIPv4Stack=true",
    "dev:sandbox:persistent": "node mvnw.cjs compile -pl acc-ms-aio spring-boot:run -Dspring-boot.run.profiles=local,sandbox -Djava.net.preferIPv4Stack=true",
    "dev:sandbox:pristine": "node mvnw.cjs compile -pl acc-ms-aio spring-boot:run -Dspring-boot.run.profiles=local,sandbox -Dapplication.sandbox.dev.pristine=true -Djava.net.preferIPv4Stack=true",
    "dev:sandbox:test": "node mvnw.cjs compile -pl acc-ms-aio spring-boot:run -Dspring-boot.run.profiles=local,sandbox -Dapplication.sandbox.mode=TEST -Djava.net.preferIPv4Stack=true",
    "test": "node mvnw.cjs test",
    "test:sandbox": "node mvnw.cjs -pl acc-sandbox test",
    "test:modulith": "node mvnw.cjs -am -pl acc-ms-aio test -Dtest=ModularityTests -Dsurefire.failIfNoSpecifiedTests=false",
    "lint": "node mvnw.cjs test-compile -DskipTests",
    "check-types": "node mvnw.cjs test-compile -DskipTests",
    "clean": "node mvnw.cjs clean",
    "db-migrate-local": "node mvnw.cjs -pl acc-db spring-boot:run -Dspring-boot.run.profiles=local \"-Dspring-boot.run.jvmArguments=-Dschema=identity -DLIQUIBASE_CONTEXTS=dev\""
  }
}
