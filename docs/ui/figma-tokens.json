{
  "$schema": "https://tokens.studio/dtcg.json",
  "name": "ACC Light Mode Liquid Glass Design System Tokens",
  "version": "1.0.0",
  "color": {
    "surface": {
      "base": {
        "$type": "color",
        "$value": "rgba(255, 255, 255, 0.65)",
        "$description": "Luminous frosted crystal ice surface (Default Light Mode)"
      },
      "hover": {
        "$type": "color",
        "$value": "rgba(255, 255, 255, 0.82)",
        "$description": "Interactive light glass hover state"
      },
      "active": {
        "$type": "color",
        "$value": "rgba(241, 245, 249, 0.95)",
        "$description": "Active pressed light glass surface"
      }
    },
    "background": {
      "page": {
        "$type": "color",
        "$value": "#F8FAFC",
        "$description": "Light slate crystal canvas background"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#0F172A",
        "$description": "Deep slate high-contrast body text"
      },
      "secondary": {
        "$type": "color",
        "$value": "#475569",
        "$description": "Slate secondary text"
      }
    },
    "border": {
      "specular": {
        "$type": "color",
        "$value": "linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(203, 213, 225, 0.5) 40%, rgba(0, 180, 216, 0.4) 100%)",
        "$description": "1px inset specular rim light border gradient"
      }
    },
    "ambient": {
      "cyanGlow": {
        "$type": "color",
        "$value": "#00b4d8",
        "$description": "Cyan active pipeline ambient light"
      },
      "magentaGlow": {
        "$type": "color",
        "$value": "#d946ef",
        "$description": "Magenta human review gate ambient light"
      },
      "emeraldSuccess": {
        "$type": "color",
        "$value": "#059669",
        "$description": "Emerald green published status light"
      }
    }
  },
  "backdropBlur": {
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "18px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "32px"
    }
  }
}
