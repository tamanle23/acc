{
  "pipelines": {
    "mp4_luma": {
      "format": "mp4",
      "vcodec": "libx264",
      "pix_fmt": "yuv420p",
      "blend_mode_recommended": "screen",
      "background": "black"
    },
    "webm_alpha": {
      "format": "webm",
      "vcodec": "libvpx-vp9",
      "pix_fmt": "yuva420p",
      "blend_mode_recommended": "normal",
      "background": "transparent"
    }
  },
  "effects": {
    "rain": {
      "category": "Weather",
      "pipeline": "mp4_luma",
      "variants": ["drizzle", "heavy_rain", "storm"],
      "module_path": "./src/overlay-effects/generators/rain.ts"
    },
    "snow": {
      "category": "Weather",
      "pipeline": "mp4_luma",
      "variants": ["light_snow", "flurries", "blizzard"],
      "module_path": "./src/overlay-effects/generators/snow.ts"
    },
    "dust": {
      "category": "Atmosphere",
      "pipeline": "mp4_luma",
      "variants": ["ambient_dust", "sunshaft_dust"],
      "module_path": "./src/overlay-effects/generators/dust.ts"
    },
    "fog": {
      "category": "Atmosphere",
      "pipeline": "mp4_luma",
      "variants": ["ground_mist", "dense_fog"],
      "module_path": "./src/overlay-effects/generators/fog.ts"
    },
    "light_leak": {
      "category": "Atmosphere",
      "pipeline": "mp4_luma",
      "variants": ["edge_burns", "transition_flash"],
      "module_path": "./src/overlay-effects/generators/light_leak.ts"
    },
    "embers": {
      "category": "Action & Fire",
      "pipeline": "mp4_luma",
      "variants": ["campfire_sparks", "windy_sparks"],
      "module_path": "./src/overlay-effects/generators/embers.ts"
    },
    "smoke": {
      "category": "Action & Fire",
      "pipeline": "mp4_luma",
      "variants": ["rising_steam", "rolling_smoke"],
      "module_path": "./src/overlay-effects/generators/smoke.ts"
    },
    "lightning": {
      "category": "Action & Fire",
      "pipeline": "mp4_luma",
      "variants": ["sheet_lightning", "branching_lightning"],
      "module_path": "./src/overlay-effects/generators/lightning.ts"
    },
    "fire": {
      "category": "Action & Fire",
