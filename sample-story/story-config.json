{
  "name": "Dinosaur_Story",
  "description": "A short story about a dinosaur in a distant kingdom",
  "settings": {
    "platform": "youtube",
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "container": "mp4",
    "videoCodec": "h264",
    "crf": 20,
    "preset": "p4",
    "pixelFormat": "yuv420p",
    "audioCodec": "aac",
    "audioBitrate": "192k",
    "gpuAcceleration": "auto",
    "concurrency": "auto",
    "fastIntermediate": true,
    "fastStart": true,
    "captions": {
      "preset": "cinematic",
      "subtitleMode": "burn",
      "position": "bottom",
      "activeWordHighlight": true,
      "wordsPerPhrase": 6,
      "highlightPreset": "scale-color",
      "highlightColor": "#00FFFF",
      "autoTranscribe": true
    },
    "transition": {
      "enabled": true,
      "type": "fade",
      "duration": 1,
      "audioBehavior": "pad"
    },
    "upscale": {
      "enabled": false,
      "model": "realesrgan-x4plus"
    },
    "tts": {
      "provider": "vieneu-v3-turbo",
      "voice": "Ngọc Trân",
      "speed": 1
    },
    "pauseBetweenScenes": 1,
    "bgm": {
      "source": "bgm.mp3",
      "volume": 0.2,
      "loop": true,
      "fadeIn": 2,
      "autoDucking": true
    }
  },
  "scenes": [
    {
      "image": "scene1.jpg",
      "audio": "voiceover1.mp3",
      "transition": {
        "enabled": true,
        "type": "wipeleft",
        "duration": 1.5,
        "audioBehavior": "pad"
      },
      "depth3d": {
        "enabled": true,
        "mode": "frame_breaker",
        "frameStyle": "polaroid",
        "autoSegment": true,
        "popOutIntensity": 1.25,
        "shadow": true,
        "floatMotion": true,
        "backdropBlur": 20
      },
      "captions": [
        { "text": "Ngày", "start": 0, "end": 0.35 },
        { "text": "xửa", "start": 0.35, "end": 0.7 },
        { "text": "ngày", "start": 0.7, "end": 1.05 },
        { "text": "xưa...", "start": 1.05, "end": 1.85 }
      ]
    },
    {
      "image": "scene2.jpg",
      "audio": "voiceover2.mp3",
      "depth3d": {
        "enabled": true,
        "mode": "frame_breaker",
        "frameStyle": "comic",
        "autoSegment": true,
        "popOutIntensity": 1.2,
        "shadow": true,
        "floatMotion": false
      },
      "captions": [
        { "text": "Ở một", "start": 0, "end": 0.4 },
        { "text": "vương quốc", "start": 0.4, "end": 0.9 },
        { "text": "xa xôi,", "start": 0.9, "end": 1.5 },
        { "text": "có một chú khủng long.", "start": 1.5, "end": 2.3 }
      ]
    },
    {
      "image": "scene1.jpg",
      "text": "Khung hình điện ảnh Cinema với phần đầu vượt mép viền trên ấn tượng.",
      "depth3d": {
        "enabled": true,
        "mode": "frame_breaker",
        "frameStyle": "cinema",
        "autoSegment": true,
        "popOutIntensity": 1.3,
        "shadow": true,
        "floatMotion": true
      },
      "captions": []
    },
    {
      "image": "scene2.jpg",
      "text": "Thẻ bài Trading Card bo góc hiện đại với bóng đổ đa tầng sang trọng.",
      "depth3d": {
        "enabled": true,
        "mode": "frame_breaker",
        "frameStyle": "card",
        "autoSegment": true,
        "popOutIntensity": 1.25,
        "shadow": true,
        "floatMotion": true
      },
      "captions": []
    },
    {
      "image": "scene2.jpg",
      "text": "Kỹ thuật Sandwich 3D đặt dòng chữ nổi bật phía sau nhân vật cùng bụi sáng.",
      "depth3d": {
        "enabled": true,
        "mode": "volumetric_sandwich",
        "autoSegment": true,
        "sandwich": {
          "textBehindSubject": true,
          "ambientDust": true,
          "vignette": true,
          "bannerText": "JURASSIC REALM",
          "textColor": "rgba(255, 230, 120, 0.95)"
        }
      },
      "captions": []
    },
    {
      "image": "scene1.jpg",
      "text": "Chuyển động camera quỹ đạo 3D xoay vòng quanh mô hình độ sâu 16-bit.",
      "depth3d": {
        "enabled": true,
        "mode": "depth_map_3d",
        "autoDepth": true,
        "depthMesh": {
          "motion": "circle",
          "displacementScale": 20
        }
      },
      "captions": []
    },
    {
      "image": "scene2.jpg",
      "text": "Hiệu ứng đẩy sâu camera Zoom Perspective xuyên qua các lớp không gian.",
      "depth3d": {
        "enabled": true,
        "mode": "depth_map_3d",
        "autoDepth": true,
        "depthMesh": {
          "motion": "zoom",
          "displacementScale": 22
        }
      },
      "captions": []
    },
    {
      "image": "scene1.jpg",
      "text": "Hiệu ứng Dolly Zoom tạo cảm giác thị sai kịch tính giữa chủ thể và hậu cảnh.",
      "depth3d": {
        "enabled": true,
        "mode": "parallax_25d",
        "autoSegment": true,
        "parallax": {
          "cameraMotion": "dolly_zoom",
          "intensity": 1.3,
          "depthBlur": true,
          "foregroundElements": true
        }
      },
      "captions": []
    },
    {
      "image": "scene2.jpg",
      "text": "Góc quay lia máy Pan Right đa tầng mang lại trải nghiệm điện ảnh sâu sắc.",
      "depth3d": {
        "enabled": true,
        "mode": "parallax_25d",
        "autoSegment": true,
        "parallax": {
          "cameraMotion": "pan_right",
          "intensity": 1.2,
          "depthBlur": true,
          "foregroundElements": true
        }
      },
      "captions": []
    },
    {
      "image": "scene1.jpg",
      "text": "Wigglegram ngang mô phỏng máy ảnh chụp phim lập thể kèm hiệu ứng quang sai màu.",
      "depth3d": {
        "enabled": true,
        "mode": "wigglegram",
        "wigglegram": {
          "frequency": 7,
          "amplitude": 14,
          "direction": "horizontal",
          "chromaticAberration": true
        }
      },
      "captions": []
    },
    {
      "image": "scene2.jpg",
      "text": "Wigglegram xoay nghiêng Rotational tạo độ rung lắc thị giác độc đáo.",
      "depth3d": {
        "enabled": true,
        "mode": "wigglegram",
        "wigglegram": {
          "frequency": 6,
          "amplitude": 12,
          "direction": "rotational",
          "chromaticAberration": true
        }
      },
      "captions": []
    },
    {
      "video": "b-roll-nature.mp4",
      "text": "Khung cảnh thiên nhiên thác nước chân thực kết hợp mượt mà với kịch bản.",
      "videoSettings": {
        "timeBase": "audio",
        "shortVideoMode": "loop",
        "longVideoMode": "trim",
        "volume": 0.15
      },
      "captions": []
    }
  ]
}