{
  "name": "Dinosaur_Story",
  "description": "A short story about a dinosaur in a distant kingdom",
  "settings": {
    "platform": "youtube",
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "container": "mp4",
    "videoCodec": "h264",
    "crf": 20,
    "preset": "p4",
    "pixelFormat": "yuv420p",
    "audioCodec": "aac",
    "audioBitrate": "192k",
    "gpuAcceleration": "auto",
    "concurrency": "auto",
    "fastIntermediate": true,
    "fastStart": true,
    "captions": {
      "preset": "cinematic",
      "subtitleMode": "burn",
      "position": "bottom",
      "wordsPerPhrase": 6,
      "highlightPreset": "scale-color",
      "highlightColor": "#00FFFF"
    },
    "transition": {
      "enabled": true,
      "type": "fade",
      "duration": 1.0,
      "audioBehavior": "pad"
    },
    "upscale": {
      "enabled": false,
      "model": "realesrgan-x4plus"
    },
    "tts": {
      "provider": "vieneu-v3-turbo",
      "voice": "hn-quynhanh",
      "speed": 1.0
    },
    "pauseBetweenScenes": 1.0,
    "bgm": {
      "source": "bgm.mp3",
      "volume": 0.2,
      "loop": true,
      "fadeIn": 2.0
    }
  },
  "scenes": [
    {
      "image": "scene1.jpg",
      "audio": "voiceover1.mp3",
      "transition": {
        "enabled": true,
        "type": "wipeleft",
        "duration": 1.5,
        "audioBehavior": "pad"
      },
      "depth3d": {
        "enabled": true,
        "mode": "frame_breaker",
        "frameStyle": "polaroid",
        "popOutIntensity": 1.2,
        "elevationShadow": true,
        "floatingMotion": true
      },
      "captions": [
        {
          "text": "Ngày",
          "start": 0.0,
          "end": 0.35
        },
        {
          "text": "xửa",
          "start": 0.35,
          "end": 0.7
        },
        {
          "text": "ngày",
          "start": 0.7,
          "end": 1.05
        },
        {
          "text": "xưa...",
          "start": 1.05,
          "end": 1.85
        }
      ]
    },
    {
      "image": "scene2.jpg",
      "audio": "voiceover2.mp3",
      "depth3d": {
        "enabled": true,
        "mode": "volumetric_sandwich",
        "sandwich": {
          "textBehindSubject": true,
          "ambientDust": true,
          "vignette": true
        }
      },
      "captions": [
        {
          "text": "Ở một",
          "start": 0.0,
          "end": 0.4
        },
        {
          "text": "vương quốc",
          "start": 0.4,
          "end": 0.9
        },
        {
          "text": "xa xôi,",
          "start": 0.9,
          "end": 1.5
        },
        {
          "text": "có một chú khủng long.",
          "start": 1.5,
          "end": 2.3
        }
      ]
    },
    {
      "image": "scene1.jpg",
      "text": "Chú khủng long này rất thân thiện và tốt bụng.",
      "depth3d": {
        "enabled": true,
        "mode": "depth_map_3d",
        "depthMesh": {
          "motion": "circle",
          "displacementScale": 18
        }
      },
      "captions": []
    }
  ]
}