{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["bun", "node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@acc/core": ["packages/core/src/index.ts"],
      "@acc/core/*": ["packages/core/src/*"],
      "@acc/ir": ["packages/ir/src/index.ts"],
      "@acc/ir/*": ["packages/ir/src/*"],
      "@acc/proto": ["packages/proto/src/index.ts"],
      "@acc/proto/*": ["packages/proto/src/*"]
    }
  }
}
