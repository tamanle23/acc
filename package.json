{
  "name": "@unipost",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "coverage:report": "node scripts/generate-coverage-report.mjs",
    "coverage:open": "node scripts/generate-coverage-report.mjs --open",
    "coverage:all": "node scripts/generate-coverage-report.mjs --run --open",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "esbuild": "0.18.20"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.18.20"
    }
  }
}