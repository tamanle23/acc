{
  "name": "acc",
  "description": "Automated Content Creator",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "bun test autogenerated-tests",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    
    "auto-config": "bun run auto-config.ts",
    "overlay-effects": "bun run overlay-effects-cli.ts",
    "overlay": "bun run cli.ts overlay",
    "sfx": "bun run cli.ts sfx",
    "benchmark-ai": "bun run scripts/batch-benchmark-ai.ts",
    "bench": "bun run benchmarks/run-all.ts",
    "bench:micro": "bun run benchmarks/micro/runner.ts",
    "bench:http": "bun run benchmarks/http/load-test-webhook.ts",
    "bench:cli": "bun run benchmarks/cli/benchmark-cli.ts"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.2",
    "mitata": "^1.0.34",
    "turbo": "^2.4.4"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@huggingface/transformers": "^4.3.0",
    "@io-orkes/conductor-javascript": "^4.0.0",
    "@napi-rs/canvas": "^1.0.9",
    "extract-zip": "^2.0.1",
    "linebyline": "^1.3.0",
    "simplex-noise": "^4.0.3",
    "uv": "^1.4.0",
    "wavefile": "^11.0.0",
    "yauzl": "^3.4.0"
  },
  "packageManager": "pnpm@9.0.0"
}
