{
  "name": "@acc",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",

    "dev:sandbox": "turbo dev --filter=@acc/backend --filter=@acc/console",
    "dev:backend:sandbox": "pnpm --filter @acc/backend dev:sandbox",
    "dev:console:sandbox": "pnpm --filter @acc/console dev:sandbox",
    "test:backend:sandbox": "pnpm --filter @acc/backend test:sandbox",
    "test:e2e": "pnpm --filter @acc/console test:e2e",
    "test:e2e:live": "pnpm --filter @acc/console test:e2e:live",
    "coverage:report": "node scripts/generate-coverage-report.mjs",
    "coverage:open": "node scripts/generate-coverage-report.mjs --open",
    "coverage:all": "node scripts/generate-coverage-report.mjs --run --open",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",

    "lint": "bun run scripts/check-native-imports.ts",
    "test": "bun test autogenerated-tests",
    "coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage autogenerated-tests && bun run scripts/generate-coverage-html.ts",
    "coverage:studio": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage autogenerated-tests/studio && bun run scripts/generate-coverage-html.ts",
    "coverage:html": "bun run scripts/generate-coverage-html.ts",
    "auto-config": "bun run auto-config.ts",
    "acc": "bun run apps/cli/src/index.ts",
    "ir-render": "bun run apps/cli/src/index.ts ir-render",
    "overlay-effects": "bun run overlay-effects-cli.ts",
    "overlay": "bun run apps/cli/src/index.ts overlay",
    "sfx": "bun run apps/cli/src/index.ts sfx",
    "benchmark-ai": "bun run scripts/batch-benchmark-ai.ts",
    "bench": "bun run benchmarks/run-all.ts",
    "bench:micro": "bun run benchmarks/micro/runner.ts",
    "bench:http": "bun run benchmarks/http/load-test-webhook.ts",
    "bench:cli": "bun run benchmarks/cli/benchmark-cli.ts",
    "supervisor:dev": "bun --cwd apps/ai-supervisor dev",
    "supervisor:build": "bun --cwd apps/ai-supervisor build",
    "worker:dev": "bun --cwd apps/worker dev",
    "studio:dev": "bun --cwd apps/studio dev",
    "studio:build": "bun --cwd apps/studio build"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "@types/bun": "latest",
    "@types/node": "^26.6.2",
    "mitata": "^1.0.34",
    "pts": "^1.0.3",
    "turbo": "^2.11.7"
  },
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "esbuild": "0.18.20"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.18.20"
    }
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@huggingface/transformers": "^4.3.0",
    "@io-orkes/conductor-javascript": "^4.0.0",
    "@napi-rs/canvas": "^1.0.9",
    "extract-zip": "^2.0.1",
    "gsap": "^3.12.7",
    "linebyline": "^1.3.0",
    "simplex-noise": "^4.0.3",
    "uv": "^1.4.0",
    "wavefile": "^11.0.0",
    "yauzl": "^3.4.0"
  },
}
