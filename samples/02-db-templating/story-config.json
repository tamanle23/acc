{
  "name": "02 db templating",
  "description": "Adapted from Pipeline [db-templating] via Universal AutoConfigLegacyBridgeAdapter",
  "settings": {
    "platform": "youtube",
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "container": "mp4",
    "videoCodec": "h264",
    "crf": 20,
    "preset": "p4",
    "pixelFormat": "yuv420p",
    "audioCodec": "aac",
    "audioBitrate": "192k",
    "gpuAcceleration": "auto",
    "concurrency": "auto",
    "fastIntermediate": true,
    "fastStart": true,
    "pauseBetweenScenes": 0.5,
    "bgm": {
      "source": "assets/bgm_synth.mp3",
      "volume": 0.25,
      "loop": true,
      "fadeIn": 1.5,
      "fadeOut": 2,
      "autoDucking": true
    },
    "captions": {
      "preset": "bold-retro",
      "subtitleMode": "burn",
      "position": "bottom",
      "fontSize": 36,
      "primaryColor": "#F8FAFC",
      "highlightColor": "#38BDF8",
      "activeWordHighlight": false,
      "autoTranscribe": true
    },
    "overlayComposite": "sci_fi_hud",
    "depth3d": {
      "enabled": true,
      "mode": "isometric_podium",
      "frameStyle": "cinema",
      "popOutIntensity": 1.3,
      "shadow": true
    },
    "sfx": [
      {
        "source": "assets/sfx_data_blip.wav",
        "time": 0.2,
        "duration": 0.5,
        "volume": 0.9,
        "duckBgm": false
      },
      {
        "source": "assets/sfx_sub_drop.wav",
        "time": 2,
        "duration": 2,
        "volume": 1,
        "duckBgm": true
      }
    ]
  },
  "scenes": [
    {
      "duration": 20,
      "image": "assets/brand_logo.png"
    }
  ]
}