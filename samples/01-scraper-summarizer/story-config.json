{
  "name": "01 scraper summarizer",
  "description": "Adapted from Pipeline [scraper-summarizer] via Universal AutoConfigLegacyBridgeAdapter",
  "settings": {
    "platform": "tiktok",
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "container": "mp4",
    "videoCodec": "h264",
    "crf": 20,
    "preset": "p4",
    "pixelFormat": "yuv420p",
    "audioCodec": "aac",
    "audioBitrate": "192k",
    "gpuAcceleration": "auto",
    "concurrency": "auto",
    "fastIntermediate": true,
    "fastStart": true,
    "pauseBetweenScenes": 0.5,
    "bgm": {
      "source": "assets/bgm_tech.mp3",
      "volume": 0.25,
      "loop": true,
      "fadeIn": 1.5,
      "fadeOut": 2,
      "autoDucking": true
    },
    "captions": {
      "preset": "minimal-clean",
      "subtitleMode": "burn",
      "position": "bottom",
      "fontSize": 28,
      "primaryColor": "#FFFFFF",
      "highlightColor": "#00FFFF",
      "activeWordHighlight": false,
      "autoTranscribe": true
    },
    "transition": {
      "enabled": true,
      "type": "fade",
      "duration": 0.4,
      "audioBehavior": "pad"
    },
    "overlayComposite": "camera_ui",
    "depth3d": {
      "enabled": true,
      "mode": "isometric_billboard",
      "frameStyle": "card",
      "popOutIntensity": 1.2,
      "shadow": true
    },
    "sfx": [
      {
        "source": "assets/sfx_notification.wav",
        "time": 0.1,
        "duration": 0.8,
        "volume": 0.8,
        "duckBgm": true
      }
    ]
  },
  "scenes": [
    {
      "duration": 12,
      "text": "The AI landscape shifted dramatically today as major research laboratories unveiled next-generation autonomous architectures featuring real-time perceptual grounding and sub-second reasoning loops.",
      "image": "assets/editorial_cover.png",
      "transition": {
        "enabled": true,
        "type": "glitch",
        "duration": 0.4,
        "audioBehavior": "pad"
      },
      "sfx": [
        {
          "source": "assets/sfx_whoosh.wav",
          "time": 0,
          "duration": 1,
          "volume": 0.7,
          "duckBgm": true
        }
      ]
    }
  ]
}