{
  "name": "06 ambient loops",
  "description": "Adapted from Pipeline [ambient-loops] via Universal AutoConfigLegacyBridgeAdapter",
  "settings": {
    "platform": "youtube",
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "container": "mp4",
    "videoCodec": "h264",
    "crf": 20,
    "preset": "p4",
    "pixelFormat": "yuv420p",
    "audioCodec": "aac",
    "audioBitrate": "192k",
    "gpuAcceleration": "auto",
    "concurrency": "auto",
    "fastIntermediate": true,
    "fastStart": true,
    "pauseBetweenScenes": 0.5,
    "bgm": {
      "source": "assets/lofi_sleep_beat_loop.mp3",
      "volume": 0.8,
      "loop": true,
      "fadeIn": 1.5,
      "fadeOut": 2,
      "autoDucking": true
    },
    "captions": {
      "preset": "classic",
      "subtitleMode": "burn",
      "position": "bottom",
      "fontSize": 22,
      "primaryColor": "#E2E8F0",
      "highlightColor": "#00FFFF",
      "activeWordHighlight": false,
      "autoTranscribe": true
    },
    "transition": {
      "enabled": true,
      "type": "fade",
      "duration": 1.2,
      "audioBehavior": "pad"
    },
    "overlayComposite": "rain_on_glass",
    "depth3d": {
      "enabled": true,
      "mode": "macro_bokeh",
      "popOutIntensity": 1.1,
      "shadow": false
    },
    "sfx": [
      {
        "source": "assets/sfx_rain_sound.wav",
        "time": 0,
        "duration": 8,
        "volume": 0.7,
        "duckBgm": false
      },
      {
        "source": "assets/sfx_tape_hiss.wav",
        "time": 0,
        "duration": 5,
        "volume": 0.3,
        "duckBgm": false
      }
    ]
  },
  "scenes": [
    {
      "duration": 60,
      "image": "assets/ambient_texture.png",
      "transition": {
        "enabled": true,
        "type": "fade",
        "duration": 1.2,
        "audioBehavior": "pad"
      }
    }
  ]
}