{
  "name": "05 rule logic",
  "description": "Adapted from Pipeline [rule-logic] via Universal AutoConfigLegacyBridgeAdapter",
  "settings": {
    "platform": "youtube",
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "container": "mp4",
    "videoCodec": "h264",
    "crf": 20,
    "preset": "p4",
    "pixelFormat": "yuv420p",
    "audioCodec": "aac",
    "audioBitrate": "192k",
    "gpuAcceleration": "auto",
    "concurrency": "auto",
    "fastIntermediate": true,
    "fastStart": true,
    "pauseBetweenScenes": 0.5,
    "bgm": {
      "source": "assets/bgm_classical.mp3",
      "volume": 0.25,
      "loop": true,
      "fadeIn": 1.5,
      "fadeOut": 2,
      "autoDucking": true
    },
    "captions": {
      "preset": "bold-retro",
      "subtitleMode": "burn",
      "position": "center",
      "fontSize": 36,
      "primaryColor": "#38BDF8",
      "highlightColor": "#F43F5E",
      "activeWordHighlight": false,
      "autoTranscribe": true
    },
    "transition": {
      "enabled": true,
      "type": "fade",
      "duration": 0.3,
      "audioBehavior": "pad"
    },
    "overlayComposite": "confetti",
    "depth3d": {
      "enabled": true,
      "mode": "extruded_text_3d",
      "popOutIntensity": 1.3,
      "shadow": true
    },
    "sfx": [
      {
        "source": "assets/sfx_chalk.wav",
        "time": 0.2,
        "duration": 0.9,
        "volume": 0.8,
        "duckBgm": false
      },
      {
        "source": "assets/sfx_success_bell.wav",
        "time": 3,
        "duration": 1.5,
        "volume": 0.9,
        "duckBgm": true
      }
    ]
  },
  "scenes": [
    {
      "duration": 10,
      "text": "[Decision Node: Logic Proof Architecture]",
      "image": "assets/board_diagram.png",
      "transition": {
        "enabled": true,
        "type": "fade",
        "duration": 0.3,
        "audioBehavior": "pad"
      }
    }
  ]
}